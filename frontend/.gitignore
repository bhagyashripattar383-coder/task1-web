@'
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js dependencies
node_modules/
frontend/node_modules/

# Build output
dist/
dist-ssr/
frontend/dist/
*.local

# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
backend/.venv/

# Local database
backend/shop.db
backend/instance/

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing and cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.tmp
*.bak
'@ | Set-Content -Path .gitignore -Encoding utf8